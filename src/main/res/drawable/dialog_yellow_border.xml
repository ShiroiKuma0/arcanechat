<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork (step 1): dialog window background - black fill with a yellow
     border so the dialog reads as a distinct surface against the black app background.
     Step 4b: the border colour now follows ?attr/colorAccent so it tracks the chosen
     accent preset. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#000000" />
    <stroke
        android:width="2dp"
        android:color="?attr/colorAccent" />
    <corners android:radius="8dp" />
</shape>
