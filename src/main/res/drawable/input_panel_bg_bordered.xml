<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork (step 1): compose/input bar background - panel colour framed by a yellow
     border (most visibly the top edge, separating it from the conversation). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFF00" />
        </shape>
    </item>
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/gray95" />
        </shape>
    </item>
</layer-list>
