<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork (Step 10): bottom-edge-only accent underline for subgroup headers.
     Negative top/left/right insets push those edges of the stroked rectangle outside the
     view bounds, leaving only the bottom line visible. Tracks the accent preset via ?attr. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="-2dp"
        android:right="-2dp"
        android:top="-2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1dp"
                android:color="?attr/colorAccent" />
        </shape>
    </item>
</layer-list>
