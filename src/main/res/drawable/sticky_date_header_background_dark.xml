<?xml version="1.0" encoding="utf-8"?>
<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- shiroikuma fork: was core_dark_85 (#1A1C20), a bluish-gray block. Black fill + a thin
         accent border matches the fork's bubble language and keeps the pill readable against
         the black conversation background. -->
    <corners android:radius="4dp" />
    <solid android:color="@color/black" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorAccent" />
</shape>
