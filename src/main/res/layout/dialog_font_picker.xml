<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork (Step 3): font picker dialog body (preview + family + weight + size). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingLeft="24dp"
    android:paddingRight="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/font_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Aa Bb Cc 123"
        android:textColor="?attr/conversation_list_item_contact_color"
        android:textSize="22sp"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Family" />
    <Spinner
        android:id="@+id/font_family"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Weight" />
    <Spinner
        android:id="@+id/font_weight"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Size (sp)" />
        <EditText
            android:id="@+id/font_size_value"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="3"
            android:gravity="end"
            android:hint="Default"
            android:textColor="?attr/conversation_list_item_contact_color" />
    </LinearLayout>
    <SeekBar
        android:id="@+id/font_size"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
