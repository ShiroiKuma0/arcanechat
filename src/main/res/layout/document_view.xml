<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="org.thoughtcrime.securesms.components.DocumentView">

    <LinearLayout
        android:id="@+id/document_container"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/document_button"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginLeft="5dp"
            android:layout_marginRight="5dp"
            android:background="@drawable/document_icon_bg"
            android:src="@drawable/ic_insert_drive_file_white_24dp"
            android:tint="?attr/colorAccent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/file" /><!-- shiroikuma fork (Step 8): was a blue
            CircleColorImageView; now black chip + accent border + accent glyph -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginStart="2dp"
            android:orientation="vertical"
            android:focusable="false"
            android:clickable="false">

            <TextView
                android:id="@+id/file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Signal.Text.Body"
                android:singleLine="true"
                android:clickable="false"
                android:ellipsize="middle"
                android:textColor="?attr/colorAccent"
                tools:text="The-Anarchist-Tension-by-Alfredo-Bonanno.pdf" />

            <TextView
                android:id="@+id/file_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/Signal.Text.Caption"
                android:clickable="false"
                android:textColor="?attr/colorAccent"
                tools:text="24kb" />
        </LinearLayout>
    </LinearLayout>
</merge>
