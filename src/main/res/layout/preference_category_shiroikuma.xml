<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: kxkb-style section header — a full-width 1px accent hairline separates it
     from the previous section, then a 20sp bold accent title with a text-width 2.5dp underline.
     The first section uses preference_category_shiroikuma_first.xml (no hairline). -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="2dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="?attr/colorAccent" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingLeft="36dp"
        android:paddingTop="8dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorAccent"
            android:textSize="20sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="2.5dp"
            android:layout_marginTop="2dp"
            android:background="?attr/colorAccent" />

    </LinearLayout>

</LinearLayout>
