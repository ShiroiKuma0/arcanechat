<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: the "Regenerate" action on the right of the automation-token row.
     Black pill with an accent border, matching the Export/Import dialog buttons. -->
<TextView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/automation_regenerate"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginLeft="8dp"
    android:background="@drawable/dialog_yellow_border"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="12dp"
    android:paddingLeft="12dp"
    android:paddingEnd="12dp"
    android:paddingRight="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:text="@string/pref_automation_regenerate"
    android:textColor="?attr/colorAccent"
    android:textSize="13sp" />
