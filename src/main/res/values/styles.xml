    <!-- shiroikuma fork (step 1): overflow / popup menus get a black background with a yellow
         border (reusing the dialog drawable) and yellow item text. -->
    <style name="ThemeOverlay.Shiroikuma.Popup" parent="@style/ThemeOverlay.AppCompat.Dark">
        <item name="popupMenuStyle">@style/Widget.Shiroikuma.PopupMenu</item>
        <item name="android:popupMenuStyle">@style/Widget.Shiroikuma.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Shiroikuma.PopupMenu.Overflow</item>
        <item name="android:colorBackground">#000000</item>
        <item name="android:textColorPrimary">?attr/colorAccent</item>
    </style>
    <style name="Widget.Shiroikuma.PopupMenu" parent="@style/Widget.AppCompat.PopupMenu">
        <item name="android:popupBackground">@drawable/dialog_yellow_border</item>
    </style>
    <style name="Widget.Shiroikuma.PopupMenu.Overflow" parent="@style/Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/dialog_yellow_border</item>
        <item name="overlapAnchor">false</item>
    </style>

    <!-- shiroikuma fork (Step 4b): accent presets. Each is a theme overlay applied at activity
         creation (DynamicTheme) on top of the base theme. Setting the three control attrs is enough
         because the popup border (dialog_yellow_border) and popup text both reference
         ?attr/colorAccent, so they follow the chosen accent automatically. -->
    <style name="ThemeOverlay.Shiroikuma.Accent.Yellow" parent="">
        <item name="colorAccent">@color/acc_yellow</item>
        <item name="colorControlActivated">@color/acc_yellow</item>
        <item name="colorControlHighlight">@color/acc_yellow</item>
    </style>
    <style name="ThemeOverlay.Shiroikuma.Accent.White" parent="">
        <item name="colorAccent">@color/acc_white</item>
        <item name="colorControlActivated">@color/acc_white</item>
        <item name="colorControlHighlight">@color/acc_white</item>
    </style>
    <style name="ThemeOverlay.Shiroikuma.Accent.Cyan" parent="">
