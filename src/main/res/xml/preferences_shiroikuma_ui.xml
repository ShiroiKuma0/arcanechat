<?xml version="1.0" encoding="utf-8"?>
<!-- shiroikuma fork: the 白い熊 ArcaneChat UI page. A folding accordion - every top-level section
     is a SkSectionCategory, folded by default - under the link to the app's own settings and a
     draggable chip index (added in code, like the swatch row of every colour role, which
     ShiroikumaUiPreferenceFragment appends to the section of its item). No row carries a colour:
     shiroikuma/SkPreferenceRows draws them from the colour roles. -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <org.thoughtcrime.securesms.shiroikuma.SkActionPreference
        android:key="sk_app_settings"
        android:title="@string/sk_app_settings"
        android:summary="@string/sk_app_settings_summary"
        app:skMain="true"
        app:skOpens="true"
        android:layout="@layout/sk_pref_row"
        android:persistent="false" />

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_eximport"
        android:title="@string/pref_ui_section_eximport">
        <org.thoughtcrime.securesms.shiroikuma.SkActionPreference
            android:key="pref_eximport"
            android:title="@string/eim_row_title"
            android:summary="@string/eim_row_summary"
            app:skMain="true"
            app:skOpens="true"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.components.SwitchPreferenceCompat
            android:key="pref_automation_enabled"
            android:title="@string/pref_automation_enabled"
            android:summary="@string/pref_automation_enabled_summary"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.components.SwitchPreferenceCompat
            android:key="pref_automation_require_token"
            android:title="@string/pref_automation_require_token"
            android:summary="@string/pref_automation_require_token_summary"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.components.AutomationTokenPreference
            android:key="pref_automation_token"
            android:title="@string/pref_automation_token"
            android:summary="@string/pref_automation_token_summary"
            android:widgetLayout="@layout/preference_widget_regenerate"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_foundation"
        android:title="@string/sk_section_foundation">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_text"
        android:title="@string/sk_section_text">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_buttons"
        android:title="@string/sk_section_buttons">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_bars"
        android:title="@string/sk_section_bars">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_dialogs"
        android:title="@string/sk_section_dialogs">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_switches"
        android:title="@string/sk_section_switches">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_lists"
        android:title="@string/sk_section_lists">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_menus"
        android:title="@string/sk_section_menus">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_marks"
        android:title="@string/sk_section_marks">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_fields"
        android:title="@string/sk_section_fields">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_chatlist"
        android:title="@string/pref_ui_section_chatlist">
        <ListPreference
            android:key="pref_chatlist_style"
            android:title="@string/pref_chatlist_style"
            android:entries="@array/chatlist_style_entries"
            android:entryValues="@array/chatlist_style_values"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.shiroikuma.SkSubheaderPreference android:title="@string/pref_fonts_category" />
        <Preference
            android:key="pref_font_list_title"
            android:title="@string/pref_font_list_title"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <Preference
            android:key="pref_font_list_preview"
            android:title="@string/pref_font_list_preview"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <Preference
            android:key="pref_font_list_date"
            android:title="@string/pref_font_list_date"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_conversation"
        android:title="@string/pref_ui_section_conversation">
        <org.thoughtcrime.securesms.shiroikuma.SkSubheaderPreference android:title="@string/pref_fonts_category" />
        <Preference
            android:key="pref_font_conv_title"
            android:title="@string/pref_font_conv_title"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <Preference
            android:key="pref_font_chat_text"
            android:title="@string/pref_font_chat_text"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_compose"
        android:title="@string/sk_section_compose">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_ticks"
        android:title="@string/pref_ui_section_ticks">
        <Preference
            android:key="pref_ticks_size"
            android:title="@string/pref_ticks_size"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.shiroikuma.SkSubheaderPreference android:title="@string/pref_ticks_subgroup_sending" />
        <Preference
            android:key="pref_ticks_glyph_sending"
            android:title="@string/pref_ticks_glyph"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.components.SwitchPreferenceCompat
            android:key="pref_ticks_spin"
            android:title="@string/pref_ticks_spin"
            android:summary="@string/pref_ticks_spin_summary"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.shiroikuma.SkSubheaderPreference android:title="@string/pref_ticks_subgroup_sent" />
        <Preference
            android:key="pref_ticks_glyph_sent"
            android:title="@string/pref_ticks_glyph"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.shiroikuma.SkSubheaderPreference android:title="@string/pref_ticks_subgroup_received" />
        <Preference
            android:key="pref_ticks_glyph_received"
            android:title="@string/pref_ticks_glyph"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.shiroikuma.SkSubheaderPreference android:title="@string/pref_ticks_subgroup_received_all" />
        <org.thoughtcrime.securesms.components.SwitchPreferenceCompat
            android:key="pref_ticks_group_all"
            android:title="@string/pref_ticks_group_all"
            android:summary="@string/pref_ticks_group_all_summary"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_glyph_received_all"
            android:title="@string/pref_ticks_glyph"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.shiroikuma.SkSubheaderPreference android:title="@string/pref_ticks_subgroup_failed" />
        <Preference
            android:key="pref_ticks_glyph_failed"
            android:title="@string/pref_ticks_glyph"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_calls"
        android:title="@string/sk_section_calls">
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_page"
        android:title="@string/sk_section_page">
        <org.thoughtcrime.securesms.shiroikuma.SkSubheaderPreference android:title="@string/pref_fonts_category" />
        <Preference
            android:key="pref_font_settings"
            android:title="@string/pref_font_settings"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_custom_fonts"
        android:title="@string/pref_ui_section_custom_fonts">
        <org.thoughtcrime.securesms.shiroikuma.SkActionPreference
            android:key="pref_font_add"
            android:title="@string/pref_font_add"
            android:summary="@string/pref_font_add_summary"
            app:skOpens="true"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

    <org.thoughtcrime.securesms.shiroikuma.SkSectionCategory
        android:key="sk_sec_maintenance"
        android:title="@string/sk_section_maintenance">
        <org.thoughtcrime.securesms.shiroikuma.SkActionPreference
            android:key="sk_reset_order"
            android:title="@string/sk_reset_order"
            android:summary="@string/sk_reset_order_summary"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.shiroikuma.SkActionPreference
            android:key="sk_reset_colors"
            android:title="@string/sk_reset_colors"
            android:summary="@string/sk_reset_colors_summary"
            app:skDestructive="true"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
        <org.thoughtcrime.securesms.shiroikuma.SkActionPreference
            android:key="pref_reset_ui"
            android:title="@string/pref_reset_ui"
            android:summary="@string/pref_reset_ui_summary"
            app:skDestructive="true"
            android:layout="@layout/sk_pref_row"
            android:persistent="false" />
    </org.thoughtcrime.securesms.shiroikuma.SkSectionCategory>

</PreferenceScreen>
