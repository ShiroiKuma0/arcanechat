<?xml version="1.0" encoding="utf-8"?>

<!-- shiroikuma fork (Step 10): the consolidated "白い熊 ArcaneChat UI" customization page.
     PreferenceCategory = section header; a non-selectable Preference with the subheader layout =
     subgroup header (indent 1); items sit at indent 1 (directly under a section) or indent 2
     (under a subgroup). Keys match the Prefs constants so ShiroikumaUiPreferenceFragment wires
     each control by key (colour swatch + RGB/hex dialog, font picker, accent + chat-list pickers). -->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:title="@string/pref_ui_section_eximport"
        android:layout="@layout/preference_category_shiroikuma_first">
        <Preference
            android:key="pref_eximport"
            android:title="@string/eim_row_title"
            android:summary="@string/eim_row_summary"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:persistent="false" />
        <!-- 保存復元 automation contract: the switch gates the exported StateExportReceiver, the
             token row copies the shared secret 自由作業盤 puts in its intents. Stored in the
             device-local AutomationAuth prefs file (persistent="false" here), never exported. -->
        <org.thoughtcrime.securesms.components.SwitchPreferenceCompat
            android:key="pref_automation_enabled"
            android:title="@string/pref_automation_enabled"
            android:summary="@string/pref_automation_enabled_summary"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:persistent="false" />
        <org.thoughtcrime.securesms.components.AutomationTokenPreference
            android:key="pref_automation_token"
            android:title="@string/pref_automation_token"
            android:summary="@string/pref_automation_token_summary"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:widgetLayout="@layout/preference_widget_regenerate"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_ui_section_general"
        android:layout="@layout/preference_category_shiroikuma">
        <ListPreference
            android:key="pref_accent"
            android:title="@string/pref_accent"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:entries="@array/accent_entries"
            android:entryValues="@array/accent_values"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_ui_section_chatlist"
        android:layout="@layout/preference_category_shiroikuma">

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_ui_subgroup_layout"
            android:selectable="false"
            android:persistent="false" />
        <ListPreference
            android:key="pref_chatlist_style"
            android:title="@string/pref_chatlist_style"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:entries="@array/chatlist_style_entries"
            android:entryValues="@array/chatlist_style_values"
            android:persistent="false" />

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_colors_category"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_color_list_title"
            android:title="@string/pref_color_list_title"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_color_list_preview"
            android:title="@string/pref_color_list_preview"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_color_list_date"
            android:title="@string/pref_color_list_date"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_color_fab"
            android:title="@string/pref_color_fab"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_fonts_category"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_font_list_title"
            android:title="@string/pref_font_list_title"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_font_list_preview"
            android:title="@string/pref_font_list_preview"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_font_list_date"
            android:title="@string/pref_font_list_date"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_ui_section_conversation"
        android:layout="@layout/preference_category_shiroikuma">

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_ui_subgroup_background"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_color_conversation_bg"
            android:title="@string/pref_color_conversation_bg"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_ui_subgroup_incoming"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_color_message_text_in"
            android:title="@string/pref_color_message_text_in"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_color_bubble_fill_in"
            android:title="@string/pref_color_bubble_fill_in"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_color_bubble_border_in"
            android:title="@string/pref_color_bubble_border_in"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_ui_subgroup_outgoing"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_color_message_text_out"
            android:title="@string/pref_color_message_text_out"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_color_bubble_fill_out"
            android:title="@string/pref_color_bubble_fill_out"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_color_bubble_border_out"
            android:title="@string/pref_color_bubble_border_out"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_fonts_category"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_font_conv_title"
            android:title="@string/pref_font_conv_title"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_font_chat_text"
            android:title="@string/pref_font_chat_text"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />

    </PreferenceCategory>

    <!-- shiroikuma fork (Step 11): configurable delivery ticks. Size is shared by the chat footer
         and the chat-list row; colour + glyph are per state. -->
    <PreferenceCategory
        android:title="@string/pref_ui_section_ticks"
        android:layout="@layout/preference_category_shiroikuma">
        <Preference
            android:key="pref_ticks_size"
            android:title="@string/pref_ticks_size"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:persistent="false" />

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_ticks_subgroup_sending"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_color_sending"
            android:title="@string/pref_ticks_colour"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_glyph_sending"
            android:title="@string/pref_ticks_glyph"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <org.thoughtcrime.securesms.components.SwitchPreferenceCompat
            android:key="pref_ticks_spin"
            android:title="@string/pref_ticks_spin"
            android:summary="@string/pref_ticks_spin_summary"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_ticks_subgroup_sent"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_color_sent"
            android:title="@string/pref_ticks_colour"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_glyph_sent"
            android:title="@string/pref_ticks_glyph"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_ticks_subgroup_received"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_color_received"
            android:title="@string/pref_ticks_colour"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_glyph_received"
            android:title="@string/pref_ticks_glyph"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_ticks_subgroup_received_all"
            android:selectable="false"
            android:persistent="false" />
        <org.thoughtcrime.securesms.components.SwitchPreferenceCompat
            android:key="pref_ticks_group_all"
            android:title="@string/pref_ticks_group_all"
            android:summary="@string/pref_ticks_group_all_summary"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_color_received_all"
            android:title="@string/pref_ticks_colour"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_glyph_received_all"
            android:title="@string/pref_ticks_glyph"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />

        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_ticks_subgroup_failed"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_color_failed"
            android:title="@string/pref_ticks_colour"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
        <Preference
            android:key="pref_ticks_glyph_failed"
            android:title="@string/pref_ticks_glyph"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_ui_section_settings_screen"
        android:layout="@layout/preference_category_shiroikuma">
        <Preference
            android:layout="@layout/preference_shiroikuma_subheader"
            android:title="@string/pref_fonts_category"
            android:selectable="false"
            android:persistent="false" />
        <Preference
            android:key="pref_font_settings"
            android:title="@string/pref_font_settings"
            android:layout="@layout/preference_shiroikuma_indent2"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_ui_section_custom_fonts"
        android:layout="@layout/preference_category_shiroikuma">
        <Preference
            android:key="pref_font_add"
            android:title="@string/pref_font_add"
            android:summary="@string/pref_font_add_summary"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/pref_ui_section_reset"
        android:layout="@layout/preference_category_shiroikuma">
        <Preference
            android:key="pref_reset_ui"
            android:title="@string/pref_reset_ui"
            android:summary="@string/pref_reset_ui_summary"
            android:layout="@layout/preference_shiroikuma_indent1"
            android:persistent="false" />
    </PreferenceCategory>

</PreferenceScreen>
